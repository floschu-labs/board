# Build config for deploying to Cloudflare Pages: `npm run build:cloudflare`.
# These are public build-time flags (not secrets), so this file is committed.
#
#   VITE_STORAGE_MODE=api  -> use the /api/data backend (Cloudflare Pages Function + D1)
#   VITE_BASE_URL=/        -> served at the domain root (not /board/ like GitHub Pages)
VITE_STORAGE_MODE=api
VITE_BASE_URL=/
